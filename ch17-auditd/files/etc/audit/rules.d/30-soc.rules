## ผู้ใช้จริงทำงานในชื่อ nobody (23.8) - ต้องมาก่อน user_exec
-a always,exit -F arch=b64 -S execve -F uid=65534 -F auid>=1000 -F auid!=unset -k nobody_exec
-a always,exit -F arch=b64 -S setuid,setreuid,setresuid -F a0=65534 -F auid>=1000 -F auid!=unset -k priv_drop_nobody

## การเปลี่ยนสิทธิ์และเจ้าของไฟล์ (23.4)
-a always,exit -F arch=b64 -S chmod,fchmod,fchmodat -F auid>=1000 -F auid!=unset -k perm_mod
-a always,exit -F arch=b64 -S chown,fchown,lchown,fchownat -F auid>=1000 -F auid!=unset -k perm_mod
-a always,exit -F arch=b64 -S setxattr,lsetxattr,fsetxattr,removexattr,lremovexattr,fremovexattr -F auid>=1000 -F auid!=unset -k perm_mod

## Kernel module (23.7)
-a always,exit -F arch=b64 -S init_module,finit_module,delete_module -k modules

## Process injection (23.33)
-a always,exit -F arch=b64 -S ptrace -F a0=0x4 -k process_injection
-a always,exit -F arch=b64 -S ptrace -F a0=0x5 -k process_injection
-a always,exit -F arch=b64 -S ptrace -F a0=0x6 -k process_injection
-a always,exit -F arch=b64 -S ptrace -F a0=0x10 -k process_injection
-a always,exit -F arch=b64 -S ptrace -F a0=0x4206 -k process_injection
-a always,exit -F arch=b64 -S process_vm_writev -k process_injection

## Dynamic linker hijacking (23.34)
-a always,exit -F path=/etc/ld.so.preload -F perm=wa -k ld_preload
-a always,exit -F path=/etc/ld.so.conf -F perm=wa -k ld_preload
-a always,exit -F dir=/etc/ld.so.conf.d -F perm=wa -k ld_preload

## คำสั่งทุกคำสั่งที่มาจากผู้ใช้ที่ login จริง - rule กว้างที่สุด ต้องอยู่ท้ายสุด
-a always,exit -F arch=b64 -S execve,execveat -F auid>=1000 -F auid!=unset -k user_exec
