[Unit]
Description=Proctitle decoder API for Graylog
After=network-online.target

[Service]
ExecStart=/usr/bin/python3 /usr/local/sbin/proctitle-api.py
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
