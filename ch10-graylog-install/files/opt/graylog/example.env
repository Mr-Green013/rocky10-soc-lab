# คัดลอกเป็น /opt/graylog/.env (สิทธิ์ 600) แล้วใส่ค่าจริงตามบทที่ 10 ขั้น 16.1
# ห้าม commit ไฟล์ .env ที่มีค่าจริง
GRAYLOG_VERSION=7.1
GRAYLOG_PASSWORD_SECRET=<openssl rand -hex 48>
GRAYLOG_ROOT_PASSWORD_SHA2=<sha256 ของรหัส admin>
GRAYLOG_EXTERNAL_URI=https://graylog-01.lab.internal/
# TUNNEL_TOKEN=<token จาก Cloudflare Zero Trust (ตัวเลือก)>
