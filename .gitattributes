# EN: Scripts that run on Linux must always use LF, even when cloned on Windows
# script ที่รันบน Linux ต้องเป็น LF เสมอ แม้ clone บน Windows
*.sh    text eol=lf
*.csv   text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.conf  text eol=lf
*.tf    text eol=lf
# EN: PowerShell 5.1 reads UTF-8 BOM + CRLF correctly
# PowerShell 5.1 อ่าน UTF-8 BOM + CRLF ได้ถูกต้อง
*.ps1   text eol=crlf
*.png   binary
*.svg   text eol=lf
