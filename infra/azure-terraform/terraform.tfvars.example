# คัดลอกเป็น terraform.tfvars แล้วแก้ค่า (terraform.tfvars อยู่ใน .gitignore)

# subscription_id = "00000000-0000-0000-0000-000000000000"
location = "southeastasia"
prefix   = "soclab"

# Public IP ของคุณ ดูได้จาก: curl -s https://api.ipify.org
admin_source_cidrs = ["203.0.113.10/32"]

admin_ssh_public_key_path = "~/.ssh/id_ed25519.pub"

# ตรวจชื่อ image จริงก่อนด้วย ./scripts/find-rocky-image.sh southeastasia
image = {
  source        = "marketplace"
  publisher     = "resf"
  offer         = "rockylinux-x86_64"
  sku           = "10-base"
  version       = "latest"
  plan_required = true
}

# กรณีใช้ Community Gallery หรือ image ที่ import เอง
# image = {
#   source   = "image_id"
#   image_id = "/subscriptions/<sub>/resourceGroups/<rg>/providers/Microsoft.Compute/galleries/<gallery>/images/rocky-10/versions/10.1.0"
# }

accept_marketplace_terms = false

# Phase 2: หลังติดตั้ง FreeIPA ใน Lab 11 แล้วเปลี่ยนเป็น true แล้ว apply อีกครั้ง
use_ipa_dns = false

# ปรับขนาดเครื่องได้ เช่น ถ้า Graylog ช้าเพราะ B-series หมด CPU credit
# vm_sizes = {
#   graylog-01 = "Standard_D4as_v5"
#   wazuh-01   = "Standard_D4as_v5"
# }

auto_shutdown = {
  enabled  = true
  time     = "2200"
  timezone = "SE Asia Standard Time"
  # email  = "you@example.com"
}

tags = {
  owner = "aod"
}
